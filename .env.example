# Development infrastructure configuration only.
# Do not place Project runtime secrets in this file (see Security design).

# Control-state database. SQLite is the development default.
# Switch to PostgreSQL 16+ by replacing this URL (see Implementation Plan, ADR-006).
DATABASE_URL=sqlite+aiosqlite:///./kallula.db

# Canonical Project workspace root. Defaults to var/workspaces.
# WORKSPACE_ROOT=var/workspaces

# Development-mode engine execution. Runs only execute when DEVELOPMENT_MODE is
# true and ENGINE_SOURCE_ROOT points at the pinned Siesta installation.
# DEVELOPMENT_MODE=true
# ENGINE_SOURCE_ROOT=vendor/siesta/factory
